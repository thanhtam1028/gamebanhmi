{
  "name": "gamebanhmi",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  // Giữ địa chỉ *.workers.dev luôn bật.
  // Tên miền riêng gamebanhmi.tcaoadm.com được gắn trực tiếp trên Cloudflare (xem README), không khai báo ở đây
  // vì token của CI không có quyền sửa tên miền.
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamebanhmi-db",
      "database_id": "1322e13b-d613-418c-9e14-7cc0cfe77344",
      "migrations_dir": "migrations"
    }
  ]
}
